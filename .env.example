# GEMINI_API_KEY: Optional AI Studio environment variable (not called automatically by MoonCode).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL of the running Express/Vite server (e.g. http://localhost:3000 or AI Studio URL).
APP_URL="MY_APP_URL"

# --- GitHub App & Private Data Repo Sync (Optional: leave empty to run in Local Mode) ---
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# PEM private key with literal \n escapes or multiline value
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_DATA_OWNER=""
GITHUB_DATA_REPO=""
GITHUB_DATA_BRANCH="main"
# Immutable numeric GitHub User ID allowlist (not username)
ALLOWED_GITHUB_USER_ID=""
# Random 32+ byte secret for HMAC signing session cookies
SESSION_SECRET=""
